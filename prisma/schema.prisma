generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PricingTier {
  FREE
  FREEMIUM
  PAID
  ENTERPRISE
  UNKNOWN
}

enum ApiAccessLevel {
  NO_API
  PUBLIC_API
  PAID_API
  ENTERPRISE_API
  RESTRICTED_API
  UNKNOWN
}

enum IntegrationType {
  EXTERNAL
  API
  NATIVE
  EMBED
  UNKNOWN
}

// ============================================================================
// PUBLIC DATA
// ============================================================================

model Tool {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String
  longDescription String?
  category        String
  
  // New Structured Metadata
  pricingTier     PricingTier      @default(UNKNOWN)
  apiAccess       ApiAccessLevel   @default(UNKNOWN)
  integration     IntegrationType  @default(UNKNOWN)
  
  // Legacy fields retained for migration
  pricing         String?
  websiteUrl      String?
  reasons         String[]
  bestFor         String?
  features        String[]
  pros            String[]
  cons            String[]
  inputTypes      String[] @default([])
  outputTypes     String[] @default([])
  capabilities    String[] @default([])
  limitations     String[] @default([])
  difficulty      String   @default("INTERMEDIATE")
  targetAudience  String[] @default([])
  affiliateUrl    String?
  lastVerifiedAt  DateTime @default(now())

  // Relationships
  favorites   Favorite[]
  recentViews RecentlyViewed[]
  projects    ProjectTool[]

  @@index([category])
}

// ============================================================================
// PRIVATE DATA (Requires Authentication & RLS)
// ============================================================================

// Note: The User model is often managed entirely by the Auth Provider (e.g. Supabase Auth)
// In Supabase, this table can reference auth.users via foreign key or simply store the UUID.
model User {
  id        String   @id // Maps to the Auth provider's UUID
  email     String   @unique
  createdAt DateTime @default(now())
  credits   Int      @default(25)

  // Relationships
  favorites   Favorite[]
  projects    Project[]
  preferences Preference?
  recentViews RecentlyViewed[]
  workflowRuns WorkflowRun[]
}

enum WorkflowRunStatus {
  PENDING
  SUCCESS
  FAILED
}

model WorkflowRun {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt         String
  status         WorkflowRunStatus @default(PENDING)
  creditsUsed    Int
  isRefunded     Boolean           @default(false)
  assetUrl       String?
  errorDetails   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
}

model Favorite {
  createdAt DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  tool_id String
  tool    Tool   @relation(fields: [tool_id], references: [id], onDelete: Cascade)

  @@id([user_id, tool_id])
  @@index([user_id])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Relationships
  tools ProjectTool[]

  @@index([user_id])
}

// Join table for Project <-> Tool
model ProjectTool {
  addedAt DateTime @default(now())

  project_id String
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  tool_id String
  tool    Tool   @relation(fields: [tool_id], references: [id], onDelete: Cascade)

  @@id([project_id, tool_id])
}

model Preference {
  id                  String   @id @default(uuid())
  preferredCategories Json     @default("[]") // Array of strings
  experienceLevel     String?
  updatedAt           DateTime @updatedAt

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model RecentlyViewed {
  viewedAt DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  tool_id String
  tool    Tool   @relation(fields: [tool_id], references: [id], onDelete: Cascade)

  @@id([user_id, tool_id])
  @@index([user_id])
}
